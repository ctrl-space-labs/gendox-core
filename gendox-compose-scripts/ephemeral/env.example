# Copy to .env (ignored by git), or let ./init-env.sh write it with free ports.
#
# One environment per checkout. The name must start with gendox-eph-, and the four
# ports must be free: slot NN gives API 81NN, frontend 31NN, Keycloak 85NN, database 55NN.
COMPOSE_PROJECT_NAME=gendox-eph-my-checkout
EPH_API_PORT=8101
EPH_FRONTEND_PORT=3101
EPH_KEYCLOAK_PORT=8501
EPH_DB_PORT=5501

# Optional provider keys. Leave them blank to work against the mock adapter
# (mock-gemini-2.0-flash), which needs no key. Fill in only the providers you want to
# hit, and prefer the cheapest model of each: these are billed per call. Apply a change
# with `docker compose up -d --wait`.
OPENAI_KEY=
GEMINI_KEY=
MISTRAL_KEY=
ANTHROPIC_KEY=
COHERE_KEY=
VOYAGE_KEY=
GROQ_KEY=
XAI_KEY=
NEBIUS_KEY=
FIRECRAWL_KEY=
