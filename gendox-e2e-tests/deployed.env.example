# Copy to .env.dev or .env.prod (both ignored by git) and fill in, or pass the same
# names as CI secrets. Used when E2E_TARGET=dev or E2E_TARGET=prod.

E2E_API_BASE_URL=
E2E_FRONTEND_URL=
# Keycloak, including the path it is served under (…/idp)
E2E_KEYCLOAK_URL=
E2E_REALM=gendox-idp-prod
# A client that allows the password grant for the test accounts. Without one, set
# E2E_TOKEN_SOURCE=browser and give the frontend's client: the suite then logs in through
# the browser and refreshes those sessions for its API calls.
E2E_CLIENT_ID=
E2E_TOKEN_SOURCE=password
# v1 or v2: the frontend the environment serves.
E2E_FRONTEND=

# The five test accounts, made by hand in the realm (config/accounts.js). {name} becomes
# user1..user4 or outsider. All share one password; in CI it is a secret.
E2E_ACCOUNT_EMAIL=e2e-smoke-{name}@example.com
E2E_ACCOUNT_PASSWORD=
# Optional, per account: E2E_USER1_EMAIL / E2E_USER1_PASSWORD … E2E_OUTSIDER_EMAIL / E2E_OUTSIDER_PASSWORD.

# With E2E_MODELS=small or large: an organization on a paid plan that includes those
# models, with test user 1 as administrator, made by hand. The LLM tests make and remove
# a project in it.
E2E_LLM_ORGANIZATION_ID=
