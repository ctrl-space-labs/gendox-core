{
  "name": "gendox-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Gendox, written with Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:v1": "E2E_FRONTEND=v1 playwright test",
    "test:v2": "E2E_FRONTEND=v2 playwright test",
    "smoke": "playwright test --config playwright.smoke.config.js",
    "smoke:v1": "E2E_FRONTEND=v1 playwright test --config playwright.smoke.config.js",
    "smoke:v2": "E2E_FRONTEND=v2 playwright test --config playwright.smoke.config.js",
    "list": "playwright test --list",
    "ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^20.10.4"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "path": "^0.12.7"
  }
}
