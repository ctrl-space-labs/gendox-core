{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The bundled main UI: server selection, confirmed commands, the window buttons and moving the window by its top bar. Remote pages get nothing.",
  "platforms": ["macOS", "windows", "linux"],
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-set-server",
    "allow-remove-server",
    "allow-run-command",
    "allow-stop-command",
    "allow-command-status",
    "allow-get-folders",
    "allow-choose-folder",
    "allow-remove-folder",
    "allow-set-working-directory",
    "allow-notification-permission",
    "allow-request-notification-permission",
    "allow-notify",
    "allow-badge",
    "allow-activity",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-deep-links",
    "allow-prepare-sign-in",
    "allow-open-sign-in",
    "allow-cancel-sign-in",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}
